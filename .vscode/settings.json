{
  // Project settings only. Personal editor preferences belong in your user settings.
  // Kept in step across customer-, employee-management-system and imalo-education-webapp.
  "[typescript][javascript][html][css][scss][json][jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  // Only format where a Prettier config exists (UI/), so root JSON keeps its own style.
  "prettier.requireConfig": true,
  "dotnet.defaultSolution": "API/CustomerManagementSystemApi/CustomerManagementSystem.slnx",
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.angular/**": true,
    "**/dist/**": true,
    "**/bin/**": true,
    "**/obj/**": true
  }
}
