{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run.sh",
      "detail": "DB container + schema, API, then ng serve",
      "type": "shell",
      "command": "./run.sh",
      "problemMatcher": []
    },
    {
      "label": "build.sh",
      "detail": "Build and test everything; starts nothing",
      "type": "shell",
      "command": "./build.sh",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "ng serve",
      "type": "npm",
      "script": "start",
      "path": "UI",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": { "regexp": "Changes detected" },
          "endsPattern": { "regexp": "bundle generation (complete|failed)" }
        }
      }
    },
    {
      "label": "ng test",
      "type": "npm",
      "script": "test",
      "path": "UI",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
