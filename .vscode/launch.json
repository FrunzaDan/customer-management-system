{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      // Needs the DB container up (run.sh starts it). Uses launchSettings.json.
      "name": "API",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/API/CustomerManagementSystemApi/CustomerManagementSystem.WebAPI/CustomerManagementSystem.WebAPI.csproj"
    },
    {
      "name": "ng serve",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "ng serve",
      "url": "http://localhost:4203/",
      "webRoot": "${workspaceFolder}/UI"
    },
    {
      // Vitest runs in Node, so debug it as a Node process (not Karma's browser page).
      "name": "ng test",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/UI",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["test", "--", "--watch=false"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "API + UI",
      "configurations": ["API", "ng serve"],
      "stopAll": true
    }
  ]
}
