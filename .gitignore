# Shared by customer-management-system, employee-management-system and imalo-education-webapp
# (identical in all three): .NET API, SQL database project, Angular UI.

# --- .NET (API and DB projects) ---
[Bb]in/
[Oo]bj/
[Pp]ublish/
*.user
*.suo
*.userprefs
*.dbmdl
*.[Cc]ache
!*.[Cc]ache/
*.nupkg
**/packages/*
!**/packages/build/
*.pfx
*.pubxml
*.publishproj

# Test results and coverage (dotnet test, Microsoft Testing Platform)
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
*.cobertura.xml

# --- Angular UI ---
/UI/node_modules/
/UI/dist/
/UI/tmp/
/UI/out-tsc/
/UI/.angular/
/UI/coverage/
npm-debug.log*
yarn-error.log*

# --- Local dev orchestration (run.sh: logs, pid files, exported dev TLS cert) ---
/.run/

# --- IDEs and editors ---
.vs/
.idea/
*.sublime-workspace
.history/
# VS Code: keep the shared launch/tasks/settings/extensions files, ignore the rest.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# --- OS ---
.DS_Store
Thumbs.db
*~

# --- Logs and local databases ---
*.log
*.mdf
*.ldf
